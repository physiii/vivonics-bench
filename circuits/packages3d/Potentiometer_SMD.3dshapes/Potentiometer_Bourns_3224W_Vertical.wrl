#VRML V2.0 utf8
# Bourns 3224W SMD Trimmer Potentiometer - 4.8x3.5x1.7mm
# Detailed model with body, adjust screw, J-leads, and markings
WorldInfo { title "Bourns 3224W" }

# Materials
Shape { appearance Appearance { material DEF BODY Material {
  ambientIntensity 0.2 diffuseColor 0.12 0.12 0.12 specularColor 0.08 0.08 0.08 shininess 0.3 } } }
Shape { appearance Appearance { material DEF ADJUST Material {
  ambientIntensity 0.3 diffuseColor 0.75 0.65 0.25 specularColor 0.5 0.45 0.2 shininess 0.6 } } }
Shape { appearance Appearance { material DEF LEAD Material {
  ambientIntensity 0.25 diffuseColor 0.7 0.7 0.68 specularColor 0.3 0.25 0.15 shininess 0.4 } } }
Shape { appearance Appearance { material DEF MARK Material {
  ambientIntensity 0.15 diffuseColor 0.9 0.9 0.85 specularColor 0.1 0.1 0.1 shininess 0.1 } } }

# Main body - centered at (0, 0, 0.85) for 1.7mm height
Transform { translation 0 0 0.85 children [
  Shape {
    appearance Appearance { material USE BODY }
    geometry IndexedFaceSet {
      creaseAngle 0.5
      coord Coordinate { point [
        -2.4 -1.75 0,  2.4 -1.75 0,  2.4 1.75 0,  -2.4 1.75 0,
        -2.4 -1.75 1.7, 2.4 -1.75 1.7, 2.4 1.75 1.7, -2.4 1.75 1.7,
        # Bevel at top edge
        -2.2 -1.55 1.7, 2.2 -1.55 1.7, 2.2 1.55 1.7, -2.2 1.55 1.7
      ]}
      coordIndex [
        0,1,2,3,-1,  4,7,6,5,-1,  0,4,5,1,-1,
        1,5,6,2,-1,  2,6,7,3,-1,  3,7,4,0,-1,
        # Top face (inset)
        8,9,10,11,-1
      ]
    }
  }
]}

# Brass adjust screw on top
Transform { translation 0 0 1.7 children [
  Shape {
    appearance Appearance { material USE ADJUST }
    geometry Cylinder { radius 0.55 height 1.0 top FALSE }
  }
]}
# Screw slot
Transform { translation 0 0 2.75 children [
  Shape {
    appearance Appearance { material USE ADJUST }
    geometry Box { size 0.8 0.15 0.3 }
  }
]}

# Three J-leads extending from bottom
Transform { translation -1.6 -1.75 -0.3 children [
  DEF LEAD1 Shape {
    appearance Appearance { material USE LEAD }
    geometry IndexedFaceSet {
      creaseAngle 0.5
      coord Coordinate { point [
        -0.2 -0.4 0, 0.2 -0.4 0, 0.2 0.4 0, -0.2 0.4 0,
        -0.2 -0.4 0.6, 0.2 -0.4 0.6, 0.2 0.4 0.6, -0.2 0.4 0.6
      ]}
      coordIndex [0,1,2,3,-1, 4,7,6,5,-1, 0,4,5,1,-1, 1,5,6,2,-1, 2,6,7,3,-1, 3,7,4,0,-1]
    }
  }
]}
Transform { translation 0 -1.75 -0.3 children [ USE LEAD1 ] }
Transform { translation 1.6 -1.75 -0.3 children [ USE LEAD1 ] }

# Pin 1 dot on top
Transform { translation -1.8 1.2 1.72 children [
  Shape {
    appearance Appearance { material USE MARK }
    geometry Cylinder { radius 0.3 height 0.05 }
  }
]}
