#VRML V2.0 utf8
# Bourns 3224W trimmer potentiometer - approximate model
# Dimensions: 4.8mm x 3.5mm x 1.7mm body, with brass adjust screw
Transform {
  children [
    # Main body
    Transform {
      translation 0 0 0.85
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.15 0.15 0.15
              specularColor 0.1 0.1 0.1
            }
          }
          geometry Box { size 4.8 3.5 1.7 }
        }
      ]
    }
    # Adjust screw on top
    Transform {
      translation 0 0 2.3
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.8 0.7 0.3
              specularColor 0.5 0.5 0.3
            }
          }
          geometry Cylinder { radius 0.6 height 1.2 }
        }
      ]
    }
    # Three terminals (J-leads)
    Transform { translation -1.6 -1.75 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Box { size 0.4 0.8 0.2 } } ] }
    Transform { translation 0 -1.75 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Box { size 0.4 0.8 0.2 } } ] }
    Transform { translation 1.6 -1.75 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Box { size 0.4 0.8 0.2 } } ] }
  ]
}
