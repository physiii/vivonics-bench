#VRML V2.0 utf8
# Shielded SMD inductor 6.3x6.3mm, 3.0mm height
# Body sits on PCB surface (z=0)
Transform {
  children [
    # Shielded body (centered at half height above board)
    Transform {
      translation 0 0 1.5
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.2 0.2 0.2
              specularColor 0.15 0.15 0.15
            }
          }
          geometry Box { size 6.3 6.3 3.0 }
        }
      ]
    }
    # Top dot marking
    Transform {
      translation 2.0 2.0 3.05
      children [
        Shape {
          appearance Appearance {
            material Material { diffuseColor 1.0 1.0 1.0 }
          }
          geometry Cylinder { radius 0.5 height 0.1 }
        }
      ]
    }
    # Two terminals on bottom (flat on board)
    Transform { translation -2.5 -3.15 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Box { size 1.2 1.5 0.3 } } ] }
    Transform { translation 2.5 -3.15 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Box { size 1.2 1.5 0.3 } } ] }
  ]
}
