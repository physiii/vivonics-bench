#VRML V2.0 utf8
# Laser Diode TO-56 package - 3 pin, through-hole
# Gets soldered into through-hole pads, can sits above board
# Pins extend from z=0 down through the board
Transform {
  children [
    # Metal can body (sits on board, extends up)
    Transform {
      translation 0 0 3.0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.35 0.35 0.4
              specularColor 0.6 0.6 0.6
            }
          }
          geometry Cylinder { radius 2.8 height 6.0 }
        }
      ]
    }
    # Lens/window
    Transform {
      translation 0 0 6.2
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.2 0.2 0.3
              specularColor 0.4 0.4 0.4
            }
          }
          geometry Cylinder { radius 1.5 height 0.5 }
        }
      ]
    }
    # Three pins (extend down through board)
    Transform { translation 1.27 0 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Cylinder { radius 0.25 height 3.5 } } ] }
    Transform { translation -0.635 1.1 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Cylinder { radius 0.25 height 3.5 } } ] }
    Transform { translation -0.635 -1.1 0 children [ Shape { appearance Appearance { material Material { diffuseColor 0.7 0.7 0.7 } } geometry Cylinder { radius 0.25 height 3.5 } } ] }
  ]
}
