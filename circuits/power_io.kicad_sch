  (text "Power & I/O  —  USB‖external 5V OR-ing, AP2112 +3V3 source, separate laser supply, AD7606 outputs, laser + monitor-PD outputs" (at 36 16 0) (effects (font (size 2.2 2.2)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001144))
  (text "J6 = ext +5V in;  USB VBUS (from MCU J1) ‖ J6 OR-ed via SS14 Schottkys (D5/D6) → +5V; U11 AP2112K-3.3 → +3V3." (at 36 22 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001145))
  (text "J3 → external AD7606 (VOUT1..4 = the 4 TIA outputs + CONVST + GND).  J4 → LASER_N/MPD_RAW pairs + LASER_V+ + GND shield/return." (at 36 28 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001146))
  (text "MPD_RAWx -> 750R sense to MPD_BIAS; INA4180A1 gain=20 -> 1k/100nF -> MPDx ESP32 ADC." (at 36 34 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001147))
  (text "LM4040C50 holds LASER_V+ - MPD_BIAS near 5V; PLT5 typ 150uA -> about 2.25V ADC and about 4.89V monitor-PD reverse bias." (at 36 40 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001148))
  (text "ISENSE headroom: keep I_laser <= 250 mA so V_sense (=I*10ohm) stays inside the ESP32 ADC range with margin." (at 36 46 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001149))
