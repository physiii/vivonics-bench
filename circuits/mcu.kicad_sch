  (text "Microcontroller — ESP32-S3-WROOM-1 (2.4GHz Wi-Fi b/g/n + Bluetooth LE + native USB) + USB Mini-B + AP2112K-3.3 LDO" (at 30 50 0) (effects (font (size 2.2 2.2)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001015))
  (text "USB Mini-B (J1) → USBLC6 ESD (U10) → 22R series resistors → ESP32: D+=GPIO20, D−=GPIO19.  VBUS → power_io." (at 30 56 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001016))
  (text "PWM1-4 -> GPIO16/38/13/14 (LEDC). ISENSE1-4 -> GPIO4/5/6/7 (ADC1_CH3/4/5/6), keeping current telemetry off ADC2." (at 30 62 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001017))
  (text "MPD1-4 -> GPIO2/1/8/9 (ADC1_CH1/0/7/8). CONVST -> GPIO17. UART/EN/BOOT -> J2." (at 30 68 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001018))
  (text "EN pulled up (REN=10k→+3V3) + POR cap (CEN=100nF). GPIO0/BOOT pulled up and exposed on J2. LDO: AP2112K-3.3, 5V→3V3." (at 30 74 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid c1d2e3f4-6000-4000-a000-000000001019))
