CONFIG_LC_ENABLE_LASER_PULSE_TEST=y
CONFIG_LC_ENABLE_WEB_DASHBOARD=y
CONFIG_LC_AD7606_SAMPLE_RATE_HZ=50
CONFIG_LC_AD7606_LOG_EVERY_N=0
