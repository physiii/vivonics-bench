#VRML V2.0 utf8
# Osram SFH2201 Silicon PIN Photodiode - D5140 TOPLED package
# 4.0x2.0x1.05mm clear silicone body, SMD
WorldInfo { title "Osram SFH2201" }

Shape { appearance Appearance { material DEF BODY Material {
  ambientIntensity 0.25 diffuseColor 0.85 0.85 0.82 specularColor 0.25 0.25 0.2 
  transparency 0.25 shininess 0.4 } } }
Shape { appearance Appearance { material DEF PAD Material {
  ambientIntensity 0.2 diffuseColor 0.65 0.6 0.45 specularColor 0.3 0.28 0.1 shininess 0.5 } } }
Shape { appearance Appearance { material DEF CATHODE Material {
  ambientIntensity 0.1 diffuseColor 0.15 0.15 0.15 specularColor 0.05 0.05 0.05 shininess 0.1 } } }

# Clear silicone body - sits on board at z=0, extends to z=1.05
Transform { translation 0 0 0.525 children [
  Shape {
    appearance Appearance { material USE BODY }
    geometry IndexedFaceSet {
      creaseAngle 0.8
      coord Coordinate { point [
        -2.0 -1.0 0, 2.0 -1.0 0, 2.0 1.0 0, -2.0 1.0 0,
        -1.85 -0.85 1.05, 1.85 -0.85 1.05, 1.85 0.85 1.05, -1.85 0.85 1.05
      ]}
      coordIndex [
        0,1,2,3,-1,  4,7,6,5,-1,
        0,4,5,1,-1,  1,5,6,2,-1,
        2,6,7,3,-1,  3,7,4,0,-1
      ]
    }
  }
]}

# Cathode marking (dark rectangle on top)
Transform { translation -1.3 0 1.06 children [
  Shape {
    appearance Appearance { material USE CATHODE }
    geometry Box { size 0.8 0.6 0.02 }
  }
]}

# Gold terminal pads on bottom - cathode (pin 1)
Transform { translation -1.25 -1.0 0 children [
  Shape {
    appearance Appearance { material USE PAD }
    geometry IndexedFaceSet {
      creaseAngle 0.5
      coord Coordinate { point [
        -0.3 -0.25 0, 0.3 -0.25 0, 0.3 0.25 0, -0.3 0.25 0,
        -0.3 -0.25 0.08, 0.3 -0.25 0.08, 0.3 0.25 0.08, -0.3 0.25 0.08
      ]}
      coordIndex [0,1,2,3,-1, 4,7,6,5,-1, 0,4,5,1,-1, 1,5,6,2,-1, 2,6,7,3,-1, 3,7,4,0,-1]
    }
  }
]}
# Gold terminal pad - anode (pin 2)
Transform { translation 1.25 -1.0 0 children [
  Shape {
    appearance Appearance { material USE PAD }
    geometry IndexedFaceSet {
      creaseAngle 0.5
      coord Coordinate { point [
        -0.3 -0.25 0, 0.3 -0.25 0, 0.3 0.25 0, -0.3 0.25 0,
        -0.3 -0.25 0.08, 0.3 -0.25 0.08, 0.3 0.25 0.08, -0.3 0.25 0.08
      ]}
      coordIndex [0,1,2,3,-1, 4,7,6,5,-1, 0,4,5,1,-1, 1,5,6,2,-1, 2,6,7,3,-1, 3,7,4,0,-1]
    }
  }
]}
