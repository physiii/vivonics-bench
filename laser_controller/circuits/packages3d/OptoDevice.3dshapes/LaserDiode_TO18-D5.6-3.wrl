#VRML V2.0 utf8
# Laser Diode TO-18 package (5.6mm can) - 3 pin through-hole
# Used for D7805I, D6505I monitor-capable laser diodes
WorldInfo { title "LaserDiode TO-18" }

Shape { appearance Appearance { material DEF CAN Material {
  ambientIntensity 0.25 diffuseColor 0.35 0.35 0.38 specularColor 0.5 0.5 0.45 shininess 0.6 } } }
Shape { appearance Appearance { material DEF LENS Material {
  ambientIntensity 0.15 diffuseColor 0.15 0.15 0.2 specularColor 0.3 0.3 0.35 shininess 0.7 } } }
Shape { appearance Appearance { material DEF PIN Material {
  ambientIntensity 0.2 diffuseColor 0.65 0.63 0.6 specularColor 0.35 0.3 0.15 shininess 0.5 } } }
Shape { appearance Appearance { material DEF FLANGE Material {
  ambientIntensity 0.2 diffuseColor 0.4 0.4 0.42 specularColor 0.4 0.4 0.35 shininess 0.5 } } }

# Metal can body - centered at z=3.0 for 6.0mm total height (sits on board at z=0)
Transform { translation 0 0 3.0 children [
  Shape {
    appearance Appearance { material USE CAN }
    geometry Cylinder { radius 2.8 height 5.4 top FALSE bottom FALSE }
  }
]}

# Top cap/lens window
Transform { translation 0 0 5.5 children [
  Shape {
    appearance Appearance { material USE LENS }
    geometry Cylinder { radius 1.4 height 0.7 }
  }
]}

# Flange ring at base
Transform { translation 0 0 0.3 children [
  Shape {
    appearance Appearance { material USE FLANGE }
    geometry Cylinder { radius 3.0 height 0.6 }
  }
]}

# Three pins extending below board (through-hole)
# Pin 1
Transform { translation 0 1.27 -1.5 children [
  DEF PIN1 Shape {
    appearance Appearance { material USE PIN }
    geometry Cylinder { radius 0.23 height 3.0 }
  }
]}
# Pin 2
Transform { translation 1.1 -0.635 -1.5 children [ USE PIN1 ] }
# Pin 3
Transform { translation -1.1 -0.635 -1.5 children [ USE PIN1 ] }

# Orientation tab on flange
Transform { translation 0 2.6 0.5 children [
  Shape {
    appearance Appearance { material USE FLANGE }
    geometry Box { size 1.0 0.4 0.8 }
  }
]}
