#VRML V2.0 utf8
# Taiyo-Yuden NR-50xx Shielded Power Inductor
# 5.0x5.0x2.0mm shielded SMD inductor
WorldInfo { title "Taiyo-Yuden NR-50xx" }

Shape { appearance Appearance { material DEF CORE Material {
  ambientIntensity 0.2 diffuseColor 0.18 0.18 0.18 specularColor 0.12 0.12 0.1 shininess 0.25 } } }
Shape { appearance Appearance { material DEF SHIELD Material {
  ambientIntensity 0.3 diffuseColor 0.22 0.22 0.22 specularColor 0.3 0.28 0.25 shininess 0.5 } } }
Shape { appearance Appearance { material DEF PAD Material {
  ambientIntensity 0.2 diffuseColor 0.65 0.63 0.58 specularColor 0.3 0.28 0.15 shininess 0.45 } } }
Shape { appearance Appearance { material DEF DOT Material {
  ambientIntensity 0.1 diffuseColor 0.85 0.85 0.82 specularColor 0.1 0.1 0.1 shininess 0.1 } } }

# Shielded body - sits on board surface, extends upward
Transform { translation 0 0 1.0 children [
  Shape {
    appearance Appearance { material USE SHIELD }
    geometry IndexedFaceSet {
      creaseAngle 0.3
      coord Coordinate { point [
        -2.5 -2.5 0, 2.5 -2.5 0, 2.5 2.5 0, -2.5 2.5 0,
        -2.3 -2.3 2.0, 2.3 -2.3 2.0, 2.3 2.3 2.0, -2.3 2.3 2.0
      ]}
      coordIndex [
        0,1,2,3,-1,  4,7,6,5,-1,
        0,4,5,1,-1,  1,5,6,2,-1,
        2,6,7,3,-1,  3,7,4,0,-1
      ]
    }
  }
]}

# Top face marking region
Transform { translation 0 0 2.02 children [
  Shape {
    appearance Appearance { material USE CORE }
    geometry Box { size 3.0 3.0 0.04 }
  }
]}

# Pin 1 dot
Transform { translation -1.8 1.8 2.04 children [
  Shape {
    appearance Appearance { material USE DOT }
    geometry Cylinder { radius 0.35 height 0.03 }
  }
]}

# Terminal pads on bottom
# Left terminal
Transform { translation -2.0 -2.5 0 children [
  DEF PAD1 Shape {
    appearance Appearance { material USE PAD }
    geometry IndexedFaceSet {
      creaseAngle 0.5
      coord Coordinate { point [
        -0.5 -0.75 0, 0.5 -0.75 0, 0.5 0.75 0, -0.5 0.75 0,
        -0.5 -0.75 0.15, 0.5 -0.75 0.15, 0.5 0.75 0.15, -0.5 0.75 0.15
      ]}
      coordIndex [0,1,2,3,-1, 4,7,6,5,-1, 0,4,5,1,-1, 1,5,6,2,-1, 2,6,7,3,-1, 3,7,4,0,-1]
    }
  }
]}
# Right terminal
Transform { translation 2.0 -2.5 0 children [ USE PAD1 ] }
